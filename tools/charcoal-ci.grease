#!/usr/bin/env grease
set -eu -o pipefail
test "$#" -eq 2
var root = ARGV[0]
var output = ARGV[1]
mkdir -p "$output"
cd "$root"
diff -qr .baseline/src/model src/model
diff -qr .baseline/src/wrap-ggb src/wrap-ggb
diff -qr .baseline/public/vendor public/vendor
cmp .baseline/src/shared/db.ts src/shared/db.ts
npm ci
python3 tools/build_examples_index.py public/examples > public/examples/index.json
python3 -m venv .doc-runtime
.doc-runtime/bin/pip install poetry==2.1.4
.doc-runtime/bin/poetry -C doc install --no-interaction
.doc-runtime/bin/poetry -C doc run sphinx-build source build/html
cp -R doc/build/html public/doc
setglobal ENV.VITE_DOCS_BASE_URL_WITHIN_APP = '/doc'
npx vite build
fork { npx vite preview --host 127.0.0.1 --port 3000 > "$output/preview.log" 2>&1 }
var preview_pid = $!
var ready = false
for attempt in @(seq 1 60) {
  try { curl --fail --silent --output /dev/null http://127.0.0.1:3000/ }
  if (_error.code === 0) { setvar ready = true; break }
  sleep 0.25
}
if (not ready) { cat "$output/preview.log" >&2; try { kill "$preview_pid" }; exit 1 }
try { npx cypress run --browser chrome --config baseUrl=http://127.0.0.1:3000,defaultCommandTimeout=30000 }
var result = _error.code
try { kill "$preview_pid" }
exit "$result"
